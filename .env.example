# ─────────────────────────────────────────────────────────────────────────
#  이 저장소의 접속 정보는 이 파일 하나로 관리합니다.
#
#      copy .env.example .env
#
#  예제 대부분이 `load_dotenv()` 를 인자 없이 부릅니다. python-dotenv 가
#  현재 폴더에서 위로 올라가며 `.env` 를 찾으므로, 어느 장 폴더에서 실행해도
#  저장소 루트의 이 파일이 잡힙니다. 장별 `.env` 는 두지 않습니다.
#
#  `.env` 는 .gitignore 에 있습니다 (확인: git check-ignore -v .env).
#  이 파일(.env.example)은 추적되니 실제 값을 절대 적지 마세요.
# ─────────────────────────────────────────────────────────────────────────


# ── 올라마 (로컬 LLM) ────────────────────────────────────────────────────
# OLLAMA_MODEL 이 채워져 있으면 올라마, 비어 있으면 OpenAI API 를 씁니다.
# 설치와 모델 고르는 근거: ch04_dev-env/SETUP.md §4

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b

# 임베딩용(6·8·11장 RAG). 대화 모델로는 안 됩니다.
# 한국어 문서를 다루면 다국어 모델이어야 합니다 — 근거는 STUDY.md
OLLAMA_EMBED_MODEL=bge-m3

# 원격·사내 올라마 서버를 쓸 때는 BASE_URL 만 그 주소로 바꿉니다.
# 그 경우 올라마를 설치할 필요도 없습니다.
#OLLAMA_BASE_URL=http://<서버주소>:11434
#OLLAMA_MODEL=<더 큰 모델 태그>


# ── OpenAI ───────────────────────────────────────────────────────────────
# 발급: https://platform.openai.com/api-keys
# OLLAMA_MODEL 을 비워 두면 이쪽을 씁니다.

OPENAI_API_KEY=


# ── Tavily (웹 검색) — 6 · 7 · 9 · 10 · 11장 ─────────────────────────────
# 발급: https://app.tavily.com/
# 올라마로 대체할 수 없습니다. 웹 검색이 필요한 절에만 쓰입니다.

TAVILY_API_KEY=


# ── Supabase (DB · 벡터 스토어) — 7 · 11장 ──────────────────────────────
# 프로젝트 설정 → API 에서 URL 과 anon key

SUPABASE_URL=
SUPABASE_KEY=


# ── 구글 드라이브 (11장) ─────────────────────────────────────────────────
# 환경변수가 아니라 파일입니다. OAuth 클라이언트 JSON 을 내려받아
# `credentials.json` 으로 두면 첫 실행 때 `token.json` 이 생깁니다.
# 둘 다 .gitignore 대상입니다. 절대 커밋하지 마세요.


# ── 예외: 10장 멀티 에이전트 예제 ────────────────────────────────────────
# ch10_a2a/examples/multi_agent 의 저자 코드는 `load_dotenv(dotenv_path="../.env")`
# 처럼 경로를 직접 지정합니다. 그 예제만 `ch10_a2a/examples/.env` 가 따로 필요합니다.
#     copy ch10_a2a\examples\.env.example ch10_a2a\examples\.env
